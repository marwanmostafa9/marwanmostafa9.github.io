---
import { Image, getImage } from 'astro:assets';
import type { MediaItem } from '../lib/media';

interface Props {
  items: MediaItem[];
  captions: Record<string, string>;
  title: string;
}
const { items, captions, title } = Astro.props;

// Larger version of each image for the full-screen viewer
const full = await Promise.all(
  items.map((m) =>
    m.kind === 'image' && m.image.format !== 'gif'
      ? getImage({ src: m.image, width: Math.min(1800, m.image.width) }).then((r) => r.src)
      : m.kind === 'image'
        ? m.image.src
        : null,
  ),
);
---

<section class="gallery" aria-label="Gallery">
  <h2 class="mono">gallery</h2>
  <div class="masonry">
    {
      items.map((m, i) => {
        const caption = captions[m.name];
        return (
          <figure>
            {m.kind === 'video' ? (
              <video src={m.src} autoplay muted loop playsinline controls preload="metadata" />
            ) : (
              <button type="button" class="open" data-full={full[i]} data-caption={caption ?? ''}>
                {m.image.format === 'gif' ? (
                  <img src={m.image.src} alt={caption ?? `${title}, image ${i + 1}`} loading="lazy" />
                ) : (
                  <Image
                    src={m.image}
                    alt={caption ?? `${title}, image ${i + 1}`}
                    widths={[480, 900].filter((w) => w < m.image.width).concat(m.image.width)}
                    sizes="(max-width: 720px) 100vw, 520px"
                  />
                )}
              </button>
            )}
            {caption && <figcaption>{caption}</figcaption>}
          </figure>
        );
      })
    }
  </div>

  <dialog class="viewer">
    <button type="button" class="close" aria-label="Close">✕</button>
    <button type="button" class="nav prev" aria-label="Previous image">‹</button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="nav next" aria-label="Next image">›</button>
  </dialog>
</section>

<style>
  .gallery {
    margin-top: 72px;
  }
  h2 {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .masonry {
    columns: 2 320px;
    column-gap: 20px;
  }
  figure {
    break-inside: avoid;
    margin: 0 0 20px;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: #0b0d1a;
    cursor: zoom-in;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .open:hover {
    border-color: color-mix(in srgb, var(--c) 55%, transparent);
    transform: translateY(-2px);
  }
  .open :global(img),
  video {
    display: block;
    width: 100%;
    height: auto;
  }
  video {
    border-radius: 14px;
    border: 1px solid var(--border);
    background: #000;
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .viewer {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(4, 5, 11, 0.97);
    backdrop-filter: blur(10px);
    color: var(--text);
  }
  .viewer[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .viewer::backdrop {
    background: transparent;
  }
  .viewer figure {
    margin: 0;
    max-width: calc(100vw - 140px);
    text-align: center;
  }
  .viewer img {
    max-width: 100%;
    max-height: calc(100vh - 120px);
    border-radius: 10px;
  }
  .viewer button {
    position: absolute;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
    border-radius: 999px;
    cursor: pointer;
  }
  .close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
  }
  .nav {
    top: 50%;
    width: 48px;
    height: 48px;
    font-size: 1.6rem;
    transform: translateY(-50%);
  }
  .prev {
    left: 20px;
  }
  .next {
    right: 20px;
  }
  @media (max-width: 720px) {
    .viewer figure {
      max-width: calc(100vw - 32px);
    }
    .nav {
      top: auto;
      bottom: 24px;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const dialog = gallery.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const items = [...gallery.querySelectorAll<HTMLButtonElement>('.open')];
    let index = 0;

    function show(i: number) {
      index = (i + items.length) % items.length;
      const item = items[index];
      img.src = item.dataset.full!;
      img.alt = item.querySelector('img')?.alt ?? '';
      caption.textContent = item.dataset.caption ?? '';
    }

    items.forEach((item, i) =>
      item.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    const single = items.length < 2;
    dialog.querySelectorAll<HTMLElement>('.nav').forEach((b) => (b.hidden = single));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
