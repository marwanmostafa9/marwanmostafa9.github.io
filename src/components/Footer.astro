---
import Icon from './Icon.astro';
import { SITE } from '../config/site';
import { href } from '../lib/url';

const { email, linkedin, github } = SITE.socials;
const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="mono">© {year} {SITE.name} · built with Astro &amp; Three.js</p>
  <nav aria-label="Elsewhere">
    {github && <a href={github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={18} /></a>}
    {linkedin && <a href={linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={18} /></a>}
    {email && <a href={`mailto:${email}`} aria-label="Email"><Icon name="mail" size={18} /></a>}
    <a href={href('/#top')} aria-label="Back to top" class="top">↑</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 28px var(--gutter) 40px;
    border-top: 1px solid var(--border);
  }
  p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  nav {
    display: flex;
    gap: 6px;
  }
  a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  a:hover {
    color: var(--text);
    border-color: rgba(167, 139, 250, 0.6);
  }
</style>
