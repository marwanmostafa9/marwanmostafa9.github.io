---
// Floating "Ask about Marwan" chat. Answers come from chat-worker/ (Groq, grounded in the CV).
// Hidden unless SITE.chatEndpoint is set.
import { SITE } from '../config/site';

const first = SITE.name.split(' ')[0];
const suggestions = [
  `What is ${first} working on now?`,
  `Has ${first} built multi-agent systems?`,
  `What Odoo experience does ${first} have?`,
  `How can I contact ${first}?`,
];
---

{
  SITE.chatEndpoint && (
    <div class="cvchat" data-endpoint={SITE.chatEndpoint}>
      <button type="button" class="launch" aria-expanded="false" aria-controls="cvchat-panel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z" />
          <path d="M8.5 12h.01M12 12h.01M15.5 12h.01" />
        </svg>
        <span>Ask about {first}</span>
      </button>

      <section class="panel" id="cvchat-panel" role="dialog" aria-label={`Ask about ${SITE.name}`} hidden>
        <header>
          <div>
            <p class="title">Ask about {first}</p>
            <p class="sub mono">AI assistant · answers from {first}'s CV</p>
          </div>
          <button type="button" class="close" aria-label="Close chat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </header>

        <div class="log" aria-live="polite">
          {/* one line: .msg uses white-space: pre-wrap */}
          <p class="msg bot">{`Hi! I can answer questions about ${first}'s experience, skills and projects. What would you like to know?`}</p>
          <div class="chips">
            {suggestions.map((s) => (
              <button type="button" class="chip">{s}</button>
            ))}
          </div>
        </div>

        <form>
          <input name="q" type="text" maxlength="800" autocomplete="off" placeholder="Type your question…" aria-label="Your question" required />
          <button type="submit" aria-label="Send">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        </form>
      </section>
    </div>
  )
}

<style>
  .cvchat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    font-family: var(--font-body);
  }
  .launch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #0b0b18;
    font: 600 0.92rem var(--font-body);
    cursor: pointer;
    box-shadow: 0 10px 30px -8px rgba(167, 139, 250, 0.6);
    transition: transform 0.2s, filter 0.2s;
  }
  .launch:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
  }
  .cvchat.open .launch {
    display: none;
  }

  .panel {
    display: flex;
    flex-direction: column;
    width: min(380px, calc(100vw - 32px));
    height: min(560px, calc(100dvh - 40px));
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(10, 12, 24, 0.94);
    backdrop-filter: blur(14px);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .title {
    margin: 0;
    font: 600 1rem var(--font-display);
  }
  .sub {
    margin: 2px 0 0;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .close:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text);
  }

  .log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    overflow-y: auto;
  }
  .log :global(.msg) {
    max-width: 88%;
    margin: 0;
    padding: 9px 13px;
    border-radius: 14px;
    font-size: 0.9rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.bot) {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-bottom-left-radius: 4px;
  }
  .log :global(.me) {
    align-self: flex-end;
    background: rgba(167, 139, 250, 0.18);
    border: 1px solid rgba(167, 139, 250, 0.35);
    border-bottom-right-radius: 4px;
  }
  .log :global(.err) {
    color: #fca5a5;
  }
  .log :global(.typing)::after {
    content: '▍';
    animation: blink 1s steps(2) infinite;
    color: var(--accent);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    padding: 6px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: 400 0.8rem var(--font-body);
    text-align: left;
    cursor: pointer;
  }
  .chip:hover {
    border-color: rgba(167, 139, 250, 0.6);
    background: rgba(167, 139, 250, 0.1);
  }

  form {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--border);
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    font: 400 0.9rem var(--font-body);
  }
  input:focus {
    outline: none;
    border-color: rgba(167, 139, 250, 0.6);
  }
  form button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #0b0b18;
    cursor: pointer;
  }
  form button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  @media (max-width: 520px) {
    .cvchat {
      right: 12px;
      bottom: 12px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.cvchat');
  if (root) {
    const endpoint = root.dataset.endpoint!;
    const launch = root.querySelector<HTMLButtonElement>('.launch')!;
    const panel = root.querySelector<HTMLElement>('.panel')!;
    const log = root.querySelector<HTMLElement>('.log')!;
    const form = root.querySelector('form')!;
    const input = form.querySelector('input')!;
    const send = form.querySelector('button')!;
    const chips = root.querySelector<HTMLElement>('.chips');
    const history: { role: 'user' | 'assistant'; content: string }[] = [];
    let busy = false;

    const setOpen = (open: boolean) => {
      root.classList.toggle('open', open);
      panel.hidden = !open;
      launch.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
      else launch.focus();
    };
    launch.addEventListener('click', () => setOpen(true));
    root.querySelector('.close')!.addEventListener('click', () => setOpen(false));
    panel.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

    const bubble = (cls: string, text = '') => {
      const p = document.createElement('p');
      p.className = `msg ${cls}`;
      p.dir = 'auto'; // Arabic answers read right-to-left
      p.textContent = text;
      log.append(p);
      log.scrollTop = log.scrollHeight;
      return p;
    };

    // Model output is plain text with light markdown: keep it as text, drop ** and turn "- " into bullets.
    const tidy = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '$1').replace(/^\s*[-*] /gm, '• ');

    async function ask(question: string) {
      if (busy || !question.trim()) return;
      busy = true;
      send.disabled = true;
      chips?.remove();
      bubble('me', question);
      history.push({ role: 'user', content: question });
      const out = bubble('bot typing');
      let answer = '';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });
        if (!res.ok || !res.body) throw new Error(String(res.status));

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buf = '';
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          const lines = buf.split('\n');
          buf = lines.pop()!;
          for (const line of lines) {
            const data = line.replace(/^data: ?/, '').trim();
            if (!line.startsWith('data:') || !data || data === '[DONE]') continue;
            try {
              answer += JSON.parse(data).choices?.[0]?.delta?.content ?? '';
            } catch {
              /* partial or non-JSON line */
            }
          }
          out.textContent = tidy(answer);
          log.scrollTop = log.scrollHeight;
        }
        if (!answer) throw new Error('empty');
        history.push({ role: 'assistant', content: answer });
      } catch {
        history.pop();
        out.classList.add('err');
        out.textContent = answer
          ? tidy(answer)
          : "Sorry, I can't answer right now. Please try again in a minute, or use the contact details on this site.";
      } finally {
        out.classList.remove('typing');
        busy = false;
        send.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = '';
      ask(q);
    });
    chips?.querySelectorAll<HTMLButtonElement>('.chip').forEach((chip) =>
      chip.addEventListener('click', () => ask(chip.textContent || '')),
    );
  }
</script>
