---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Gallery from '../../components/Gallery.astro';
import { FIELDS } from '../../config/fields';
import { exhibitNumbers, getProjects } from '../../lib/projects';
import { href } from '../../lib/url';
import { projectMedia } from '../../lib/media';

export async function getStaticPaths() {
  const projects = await getProjects();
  const numbers = exhibitNumbers(projects);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, no: numbers[project.id], prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  no: string;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}
const { project, no, prev, next } = Astro.props;
const { title, summary, field, date, tags, links, metrics, captions } = project.data;
const { gallery } = projectMedia(project.id);
const { Content } = await render(project);
const f = FIELDS[field];
const when = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const actions = [
  { url: links.demo, label: 'Live demo', primary: true },
  { url: links.github, label: 'View code' },
  { url: links.linkedin, label: 'LinkedIn post' },
].filter((a) => a.url);
---

<Base title={title} description={summary}>
  <article class="project" style={`--c:${f.color}`}>
    <div class="glow" aria-hidden="true"></div>

    <header class="phead">
      <a class="back mono" href={href(`/#wing-${field}`)}>← back to the exhibition</a>
      <p class="meta mono"><span class="dot"></span>Exhibit {no} · {f.label} · {when}</p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      {
        metrics.length > 0 && (
          <dl class="metrics">
            {metrics.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        actions.length > 0 && (
          <div class="actions">
            {actions.map((a) => (
              <a class:list={['btn', { primary: a.primary }]} href={a.url} target="_blank" rel="noopener">
                {a.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="pcover">
      <Cover project={project} eager sizes="(max-width: 1100px) 100vw, 1100px" />
    </div>

    <div class="pbody">
      <div class="prose"><Content /></div>
      {
        tags.length > 0 && (
          <aside>
            <h2 class="mono">stack</h2>
            <ul class="tags">
              {tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {gallery.length > 0 && <Gallery items={gallery} captions={captions} title={title} />}

    <nav class="pnav" aria-label="More projects">
      {
        prev ? (
          <a href={href(`/projects/${prev.id}/`)} style={`--c:${FIELDS[prev.data.field].color}`}>
            <span class="mono">← previous</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="next" href={href(`/projects/${next.id}/`)} style={`--c:${FIELDS[next.data.field].color}`}>
            <span class="mono">next →</span>
            {next.data.title}
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .project {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: 120px var(--gutter) 80px;
  }
  .glow {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    height: 600px;
    z-index: -1;
    background: radial-gradient(
      ellipse 70% 60% at 30% 0%,
      color-mix(in srgb, var(--c) 22%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  .back {
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--text);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 28px 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }
  h1 {
    margin: 14px 0 0;
    font-size: clamp(2.2rem, 6vw, 4rem);
    letter-spacing: -0.02em;
  }
  .lead {
    max-width: 60ch;
    margin: 18px 0 0;
    font-size: 1.15rem;
    color: var(--muted);
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 32px 0 0;
  }
  .metrics div {
    display: flex;
    flex-direction: column-reverse;
    min-width: 140px;
    padding: 14px 18px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--c) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 25%, transparent);
  }
  .metrics dd {
    margin: 0;
    font: 700 clamp(1.6rem, 4vw, 2.2rem) / 1.1 var(--font-display);
    color: var(--c);
  }
  .metrics dt {
    margin-top: 4px;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .pcover {
    margin: 48px 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--c) 40%, transparent);
  }
  .pbody {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
  }
  aside h2 {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 0.8rem;
    background: color-mix(in srgb, var(--c) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
  }
  .pnav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 80px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .pnav a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 45%;
    font: 600 1.05rem var(--font-display);
    text-decoration: none;
    transition: color 0.2s;
  }
  .pnav a:hover {
    color: var(--c);
  }
  .pnav .mono {
    font: 400 0.75rem var(--font-mono);
    color: var(--muted);
  }
  .pnav .next {
    text-align: right;
    margin-left: auto;
  }
  @media (max-width: 800px) {
    .pbody {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    aside {
      order: -1;
    }
  }
</style>
